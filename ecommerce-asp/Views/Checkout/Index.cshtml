@using ecommerce_asp.Models.ViewModels
@model ecommerce_asp.Models.ViewModels.CheckoutPageViewModel

<section id="cart_items" class="py-4">
    <div class="container">

        <div class="breadcrumbs">
            <ol class="breadcrumb">
                <li><a asp-controller="Home" asp-action="Index">Home</a></li>
                <li class="active">Checkout</li>
            </ol>
        </div>

        <form id="checkoutForm" asp-action="PlaceOrder" method="post">

            <div class="row">
                <div class="col-md-7">
                    <div class="panel panel-default">
                        <div class="panel-heading">
                            <h4>Billing Details</h4>
                        </div>
                        <div class="panel-body">

                            <div class="form-group">
                                <label>Full Name</label>
                                <input asp-for="Checkout.FullName" class="form-control" />
                                <span asp-validation-for="Checkout.FullName" class="text-danger"></span>
                            </div>

                            <div class="form-group">
                                <label>Email</label>
                                <input asp-for="Checkout.Email" class="form-control" />
                                <span asp-validation-for="Checkout.Email" class="text-danger"></span>
                            </div>

                            <div class="form-group">
                                <label>Phone Number</label>
                                <input asp-for="Checkout.Phone" class="form-control" />
                                <span asp-validation-for="Checkout.Phone" class="text-danger"></span>
                            </div>

                            <div class="form-group">
                                <label>Address</label>
                                <textarea asp-for="Checkout.Address" class="form-control"></textarea>
                                <span asp-validation-for="Checkout.Address" class="text-danger"></span>
                            </div>

                            <div class="form-group">
                                <label>Note (Optional)</label>
                                <textarea asp-for="Checkout.Note" class="form-control"></textarea>
                            </div>

                        </div>
                    </div>
                </div>

                <div class="col-md-5">
                    <div class="panel panel-default">
                        <div class="panel-heading">
                            <h4>Your Order</h4>
                        </div>
                        <div class="panel-body">

                            <ul class="list-group">

                                @foreach (var item in Model.Cart.CartItems)
                                {
                                    <li class="list-group-item">
                                        <div class="row">
                                            <div class="col-xs-3">
                                                <img src="~/images/@item.Image" class="img-responsive" />
                                            </div>

                                            <div class="col-xs-6">
                                                <h5>@item.ProductName</h5>
                                                <small>Qty: @item.Quanlity</small>
                                            </div>

                                            <div class="col-xs-3 text-right">
                                                <strong>$@(item.Price* item.Quanlity)</strong>
                                            </div>
                                        </div>
                                    </li>
                                }

                                <li class="list-group-item text-right">
                                    <h4>Total: <span class="text-success">$@Model.Cart.GrandTotal</span></h4>
                                </li>

                            </ul>

                            <button type="submit" class="btn btn-success btn-block btn-lg">
                                <i class="fa fa-credit-card"></i> Place Order
                            </button>

                            <a asp-controller="Cart" asp-action="Index" class="btn btn-default btn-block">
                                Back to Cart
                            </a>

                        </div>
                    </div>
                </div>

            </div>

        </form>

    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
