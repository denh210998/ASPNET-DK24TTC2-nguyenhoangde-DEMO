@model IEnumerable<ecommerce_asp.Models.OrderModel>

@{
    ViewData["Title"] = "My Orders";
}

<section id="my-orders" class="py-4" style="margin-top: 30px; margin-bottom: 40px;">
    <div class="container">
        <div class="row">
            <div class="col-sm-12">

                <div class="page-header" style="border-bottom: 2px solid #FE980F; margin-top: 0;">
                    <h2 style="margin-top: 0;">
                        <i class="fa fa-list-alt"></i> My Orders
                    </h2>
                </div>

                @if (!Model.Any())
                {
                    <div class="text-center" style="padding: 40px 0;">
                        <i class="fa fa-shopping-bag" style="font-size: 64px; color: #eee;"></i>
                        <h3 style="margin-top: 20px;">You have no orders yet</h3>
                        <p class="text-muted">
                            Start shopping now and your orders will appear here.
                        </p>
                        <a asp-controller="Home" asp-action="Index" class="btn btn-primary">
                            <i class="fa fa-shopping-cart"></i> Go shopping
                        </a>
                    </div>
                }
                else
                {
                    <div class="panel panel-default">
                        <div class="panel-heading" style="background-color: #f5f5f5;">
                            <h4 class="panel-title" style="margin: 5px 0;">
                                <i class="fa fa-history"></i> Order history
                            </h4>
                        </div>
                        <div class="panel-body" style="padding: 0;">

                            <div class="table-responsive">
                                <table class="table table-striped table-hover" style="margin-bottom: 0;">
                                    <thead>
                                        <tr>
                                            <th style="width: 90px;">Order </th>
                                            <th style="width: 170px;">Date</th>
                                            <th>Name</th>
                                            <th style="width: 140px;" class="text-right">Total</th>
                                            <th style="width: 120px;" class="text-center">Action</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var order in Model)
                                        {
                                            <tr>
                                                <td>
                                                    <span class="label label-default">
                                                        #@order.Id
                                                    </span>
                                                </td>
                                                <td>
                                                    @order.CreatedAt.ToString("dd/MM/yyyy HH:mm")
                                                </td>
                                                <td>
                                                    @order.FullName
                                                </td>
                                                <td class="text-right">
                                                    <strong style="color: #FE980F;">
                                                        $@order.TotalAmount.ToString("N2")
                                                    </strong>
                                                </td>
                                                <td class="text-center">
                                                    <a asp-action="OrderDetail"
                                                       asp-route-id="@order.Id"
                                                       class="btn btn-xs btn-info">
                                                        <i class="fa fa-eye"></i> View
                                                    </a>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>

                        </div>
                    </div>
                }

            </div>
        </div>
    </div>
</section>
