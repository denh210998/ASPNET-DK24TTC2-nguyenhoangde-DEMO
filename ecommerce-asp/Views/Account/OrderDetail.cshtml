@model ecommerce_asp.Models.OrderModel

@{
    ViewData["Title"] = "Order Detail";
}

<section id="order-detail" class="py-4" style="margin-top:30px; margin-bottom:40px;">
    <div class="container">
        <div class="row">
            <div class="col-sm-12">

                <div class="page-header" style="border-bottom:2px solid #FE980F; margin-top:0;">
                    <h2 style="margin-top:0;">
                        <i class="fa fa-file-text-o"></i>
                        Order Detail
                        <small style="margin-left:10px;">
                            <span class="label label-default">#@Model.Id</span>
                        </small>
                    </h2>
                </div>

                <div class="row">
                    <div class="col-sm-8">
                        <div class="panel panel-default">
                            <div class="panel-heading" style="background-color:#f5f5f5;">
                                <h4 class="panel-title" style="margin:5px 0;">
                                    <i class="fa fa-user"></i> Billing & Shipping
                                </h4>
                            </div>
                            <div class="panel-body">
                                <p>
                                    <strong>Name:</strong> @Model.FullName
                                </p>
                                <p>
                                    <strong>Email:</strong> @Model.Email
                                </p>
                                <p>
                                    <strong>Phone:</strong> @Model.Phone
                                </p>
                                <p>
                                    <strong>Address:</strong> @Model.Address
                                </p>
                                @if (!string.IsNullOrEmpty(Model.Note))
                                {
                                    <p>
                                        <strong>Note:</strong> @Model.Note
                                    </p>
                                }
                            </div>
                        </div>
                    </div>

                    <div class="col-sm-4">
                        <div class="panel panel-default">
                            <div class="panel-heading" style="background-color:#f5f5f5;">
                                <h4 class="panel-title" style="margin:5px 0;">
                                    <i class="fa fa-info-circle"></i> Order Summary
                                </h4>
                            </div>
                            <div class="panel-body">
                                <p>
                                    <strong>Order ID:</strong>
                                    <span class="label label-default">#@Model.Id</span>
                                </p>
                                <p>
                                    <strong>Date:</strong>
                                    @Model.CreatedAt.ToString("dd/MM/yyyy HH:mm")
                                </p>
                                <hr />
                                <p style="font-size:18px;">
                                    <strong>Total:</strong>
                                    <span style="color:#FE980F;">
                                        $@Model.TotalAmount.ToString("N2")
                                    </span>
                                </p>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="panel panel-default">
                    <div class="panel-heading" style="background-color:#f5f5f5;">
                        <h4 class="panel-title" style="margin:5px 0;">
                            <i class="fa fa-shopping-cart"></i> Order Items
                        </h4>
                    </div>
                    <div class="panel-body" style="padding:0;">
                        <div class="table-responsive">
                            <table class="table table-striped table-hover" style="margin-bottom:0;">
                                <thead>
                                    <tr>
                                        <th>Product</th>
                                        <th style="width:120px;">Image</th>
                                        <th style="width:80px;" class="text-center">Qty</th>
                                        <th style="width:120px;" class="text-right">Price</th>
                                        <th style="width:120px;" class="text-right">Total</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in Model.OrderItems)
                                    {
                                        <tr>
                                            <td>@item.ProductName</td>
                                            <td>
                                                <img src="~/images/@item.Image" style="width:80px;" class="img-thumbnail" />
                                            </td>
                                            <td class="text-center">@item.Quantity</td>
                                            <td class="text-right">
                                                $@item.Price.ToString("N2")
                                            </td>
                                            <td class="text-right">
                                                $@((item.Quantity * item.Price).ToString("N2"))
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                                <tfoot>
                                    <tr>
                                        <td colspan="4" class="text-right">
                                            <strong>Grand Total:</strong>
                                        </td>
                                        <td class="text-right">
                                            <strong style="color:#FE980F;">
                                                $@Model.TotalAmount
                                            </strong>
                                        </td>
                                    </tr>
                                </tfoot>
                            </table>
                        </div>
                    </div>
                </div>

                <div class="clearfix" style="margin-top:15px;">

                    <a asp-controller="Home" asp-action="Index" class="btn btn-primary">
                        <i class="fa fa-home"></i> Back to Home
                    </a>
                </div>

            </div>
        </div>
    </div>
</section>
