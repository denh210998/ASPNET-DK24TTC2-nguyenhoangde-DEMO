@model ecommerce_asp.Models.ViewModels.RegisterViewModel

@{
    ViewData["Title"] = "Register";
}

<section id="form">
    <div class="container">
        <div class="row">

            <div class="col-sm-4 col-sm-offset-1">
                <div class="login-form">
                    <h2>Login to your account</h2>

                    <a asp-controller="Account" asp-action="Login" class="btn btn-default">
                        Login
                    </a>
                </div>
            </div>

            <div class="col-sm-1">
                <h2 class="or">OR</h2>
            </div>

            <div class="col-sm-4">
                <div class="signup-form">
                    <h2>New User Signup!</h2>

                    <form asp-action="Register" method="post">
                        <div asp-validation-summary="All" class="text-danger"></div>

                        <input asp-for="Name" placeholder="Name" />
                        <span asp-validation-for="Name" class="text-danger"></span>

                        <input asp-for="Email" placeholder="Email Address" />
                        <span asp-validation-for="Email" class="text-danger"></span>

                        <input asp-for="Password" type="password" placeholder="Password" />
                        <span asp-validation-for="Password" class="text-danger"></span>

                        <input asp-for="ConfirmPassword" type="password" placeholder="Confirm Password" />
                        <span asp-validation-for="ConfirmPassword" class="text-danger"></span>

                        <button type="submit" class="btn btn-default">Sign up</button>
                    </form>
                </div>
            </div>

        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
